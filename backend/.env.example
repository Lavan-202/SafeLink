PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/safelink
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=*
PUBLIC_APP_URL=http://localhost:4000
# LK (Sri Lanka), IN (India), or GENERIC
EMERGENCY_REGION=LK

# Optional. Leave empty to use the phone's Call and Messages apps instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
